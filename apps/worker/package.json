{
  "name": "@prosodeus/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "bun --hot dev.ts",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "test": "bun test --preload ./tests/preload.ts tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.29",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@prosodeus/core": "workspace:*",
    "@prosodeus/shared": "workspace:*",
    "ai": "^6.0.116",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.4.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5",
    "wrangler": "^4.0.0"
  },
  "license": "MIT"
}
